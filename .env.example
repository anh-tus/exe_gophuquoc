# Docker Compose creates a separate local PostgreSQL database with three schemas.
# Set a unique password in your ignored .env file. Use URL-safe characters.
POSTGRES_PASSWORD=CHANGE_ME_DOCKER

# Optional when running backend services directly on your machine instead of Compose.
# Use the password of your existing host PostgreSQL, which may differ from Docker's.
IDENTITY_DATABASE_URL=postgresql://postgres:CHANGE_ME_LOCAL@localhost:5432/trip_trip?schema=identity
SUPPLY_DATABASE_URL=postgresql://postgres:CHANGE_ME_LOCAL@localhost:5432/trip_trip?schema=supply
BOOKING_DATABASE_URL=postgresql://postgres:CHANGE_ME_LOCAL@localhost:5432/trip_trip?schema=booking

# Development adapters. Never commit real values.
FIREBASE_PROJECT_ID=your-dev-firebase-project
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/local-service-account.json
IDENTITY_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
IDENTITY_SERVICE_URL=http://localhost:3101
SUPPLY_SERVICE_URL=http://localhost:3102
SUPPLY_SERVICE_KEY=REPLACE_WITH_RANDOM_INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_KEY=REPLACE_WITH_SAME_RANDOM_INTERNAL_SERVICE_KEY
SUPPLY_ADMIN_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY
SEPAY_MODE=disabled
SEPAY_SANDBOX_MERCHANT_ID=REPLACE_WITH_SANDBOX_MERCHANT_ID
SEPAY_SANDBOX_SECRET_KEY=REPLACE_WITH_SANDBOX_SECRET_KEY
SEPAY_SANDBOX_IPN_SECRET=REPLACE_WITH_SANDBOX_IPN_SECRET
PUBLIC_WEB_ORIGIN=http://localhost:3000
# Add these to frontend/public-web/.env.local for local GOPU AI testing.
# Never expose GEMINI_API_KEY through a NEXT_PUBLIC_ variable or commit a real key.
GEMINI_API_KEY=REPLACE_WITH_LOCAL_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
PAYMENT_PRIVATE_STORAGE_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_IDENTITY_API_URL=http://localhost:3101/v1
NEXT_PUBLIC_SUPPLY_API_URL=http://localhost:3102/v1
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:3103/v1
