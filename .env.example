# One local PostgreSQL database, separated into one schema per backend service.
# Replace CHANGE_ME with the password set for your local PostgreSQL `postgres` user.
IDENTITY_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/trip_trip?schema=identity
SUPPLY_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/trip_trip?schema=supply
BOOKING_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/trip_trip?schema=booking

# Reserved placeholders. No external provider is configured by this starter.
# ZALO_APP_ID=
# SEPAY_API_KEY=
# WEATHER_API_KEY=
# GOOGLE_MAPS_API_KEY=
